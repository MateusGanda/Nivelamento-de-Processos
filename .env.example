# Copie este arquivo para .env. O .env não vai para o Git.

# Conexão usada pelo Prisma e pela aplicação.
# Cole aqui a string de conexão do banco da equipe, recebida em particular.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Segredo usado para assinar/criptografar as sessões administrativas do Auth.js.
# Gere um valor forte e único para cada ambiente. Nunca o envie para o Git.
NEXTAUTH_SECRET=

# Usadas somente pelo comando npm run bootstrap:admin quando ainda não existir
# nenhum Usuario administrativo ativo. Não reutilize senhas reais em exemplos.
INITIAL_ADMIN_NOME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_MATRICULA=
INITIAL_ADMIN_SENHA=

# Usada somente pelo comando npm run seed:desenvolvimento, que grava dados fictícios.
# Aponte para um banco de desenvolvimento (por exemplo, a branch Indicators do Neon),
# nunca para o banco do site. O comando se recusa a rodar se for igual a DATABASE_URL.
SEED_DATABASE_URL=

# Chave do terminal da ilha de apontamento (mínimo de 16 caracteres). Quem a digitar uma vez
# no computador da ilha libera aquele terminal por 30 dias, sem acesso ao painel administrativo.
# Trocar o valor bloqueia todos os terminais já liberados. Sem ela, a ilha fica desativada.
ILHA_CHAVE=
