# Copie este arquivo para .env. O .env não vai para o Git.

# Conexão usada pelo Prisma e pela aplicação. Escolha uma das duas:
# 1. Banco da equipe: cole a string de conexão recebida em particular.
# 2. Banco local com Docker: use a linha abaixo, com a mesma senha de POSTGRES_PASSWORD.
DATABASE_URL=postgresql://gunp:troque-esta-senha@localhost:55432/gunp

# Usadas só pelo banco local (compose.yaml).
POSTGRES_USER=gunp
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gunp
POSTGRES_PORT=55432

# Acesso inicial: preencha com `node scripts/configurar-acesso.mjs`.
# Conta única de demonstração; não representa os Operadores da produção.
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
# Segredo aleatório de pelo menos 32 caracteres.
AUTH_SECRET=
