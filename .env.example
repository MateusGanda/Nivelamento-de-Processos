# Copie este arquivo para .env. O .env não vai para o Git.

# Conexão usada pelo Prisma e pela aplicação.
# Cole aqui a string de conexão do banco da equipe, recebida em particular.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Segredo usado para assinar/criptografar as sessões administrativas do Auth.js.
# Gere um valor forte e único para cada ambiente. Nunca o envie para o Git.
NEXTAUTH_SECRET=

# Usadas somente pelo comando npm run bootstrap:admin quando ainda não existir
# nenhum Usuario administrativo ativo. Não reutilize senhas reais em exemplos.
INITIAL_ADMIN_NOME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_MATRICULA=
INITIAL_ADMIN_SENHA=
