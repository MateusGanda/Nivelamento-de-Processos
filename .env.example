# Copie este arquivo para .env e troque a senha. O .env não vai para o Git.
POSTGRES_USER=gunp
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gunp
POSTGRES_PORT=55432

# Usada pelo Prisma e pela aplicação. Mantenha igual aos valores acima.
DATABASE_URL=postgresql://gunp:troque-esta-senha@localhost:55432/gunp
